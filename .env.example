# Copy to .env and point at your feed aggregator.
#
# Local Worker (npm run worker:dev), reachable from the glasses over your LAN:
#   VITE_FEED_URL=http://192.168.1.100:8787/feed
#
# Deployed Worker:
#   VITE_FEED_URL=https://cybernews-feed.YOUR-SUBDOMAIN.workers.dev/feed
VITE_FEED_URL=https://cybernews-feed.YOUR-SUBDOMAIN.workers.dev/feed
