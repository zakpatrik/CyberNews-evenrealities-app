{
  "name": "cybernews",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "evenhub pack app.json dist -o cybernews.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173",
    "qr": "evenhub qr",
    "qr:img": "node scripts/make-qr.mjs",
    "icon": "node scripts/make-icon.mjs",
    "feed-url": "node scripts/set-feed-url.mjs",
    "verify": "esbuild scripts/verify-limits.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify.mjs --log-level=warning && node node_modules/.cache/verify.mjs",
    "e2e": "esbuild scripts/e2e.ts --bundle --platform=node --format=esm --alias:@evenrealities/even_hub_sdk=./scripts/mock-sdk.ts --define:import.meta.env='{\"VITE_FEED_URL\":\"http://localhost:8787/feed\"}' --outfile=node_modules/.cache/e2e.mjs --log-level=warning && node node_modules/.cache/e2e.mjs",
    "deploy": "npm run build && npm --prefix worker run deploy",
    "feed:build": "node fetcher/build-feed.mjs --out feed.json",
    "feed:install": "npm --prefix fetcher install",
    "worker:dev": "npm run build && npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "worker:install": "npm --prefix worker install"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.8.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
